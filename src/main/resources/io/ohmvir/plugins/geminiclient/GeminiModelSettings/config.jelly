<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Gemini Model Configuration}">
        <f:entry title="${%API Key Credential}" field="apiKeyCredentialsId">
            <f:select />
        </f:entry>
        <f:entry title="${%Model Name}" field="modelName">
            <f:select />
        </f:entry>
    </f:section>
</j:jelly>
